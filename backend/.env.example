# Salin berkas ini menjadi .env lalu sesuaikan.

PORT=3000
DB_PATH=data/silo.db
TIMEZONE=Asia/Jakarta

# Autentikasi (WAJIB diganti)
JWT_SECRET=ganti-rahasia-ini-sebelum-dipakai
JWT_HOURS=8
ADMIN_EMAIL=admin@silo.local
ADMIN_NAME=Admin Silo
ADMIN_PASSWORD=admin123

# Origin frontend Laravel yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# true = pakai data simulasi (tanpa perangkat & tanpa broker MQTT)
SIMULATOR=true
SIM_BACKFILL_HOURS=6

# MQTT (dipakai saat SIMULATOR=false)
# Broker HiveMQ publik terbuka untuk siapa saja: pakai awalan topik yang unik!
MQTT_BROKER=tcp://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=
TOPIC_TELEMETRY=silo/scm/telemetry/data
TOPIC_SCAN=silo/scm/scan
TOPIC_CONTROL=silo/scm/telemetry/control

RETENTION_DAYS=30
DEVICE_TIMEOUT_SEC=30

# Threshold (opsional; bawaan = parameter simulasi di dokumen konsultasi Layer 1)
# TH_WARN_TEMP=35
# TH_CRIT_TEMP=40
# TH_WARN_HUM=65
# TH_CRIT_HUM=75
# TH_WARN_GAS=2175
# TH_CRIT_GAS=2500

# Ventilasi otomatis (flap): buka jika suhu/kelembapan/gas melewati batas;
# tutup setelah semuanya turun di bawah batas dikurangi histeresis.
# VENT_TEMP=33
# VENT_HUM=62
# VENT_GAS=2050
# VENT_TEMP_HYST=2
# VENT_HUM_HYST=3
# VENT_GAS_HYST=100
