# Konfigurasi lokal Raspberry Pi 3 (MQTT Mosquitto lokal + SQLite)

PORT=3000
DB_PATH=data/silo.db
TIMEZONE=Asia/Jakarta

# Autentikasi
JWT_SECRET=silo-raspi-local-jwt-secret-2026
JWT_HOURS=12
ADMIN_EMAIL=admin@silo.local
ADMIN_NAME=Admin Silo
ADMIN_PASSWORD=admin123

# Izinkan akses dashboard Laravel dari localhost, IP LAN Raspi, atau silo.local
CORS_ORIGINS=*

# false = data asli dari MQTT (raspi_qr_bridge.py <-> ESP32)
SIMULATOR=false
SIM_BACKFILL_HOURS=6

# Broker MQTT Mosquitto lokal di Raspberry Pi 3
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
TOPIC_TELEMETRY=silo/scm/telemetry/data
TOPIC_SCAN=silo/scm/scan
TOPIC_CONTROL=silo/scm/telemetry/control

RETENTION_DAYS=30
DEVICE_TIMEOUT_SEC=30
